# ---------------------------------------------------------------------------
# LLM configuration (optional). The app works without a key using the
# deterministic analytics planner; set a key to enable the tool-calling agent.
# ---------------------------------------------------------------------------
# groq | nvidia | openai | openrouter | custom | offline
LLM_PROVIDER=groq
LLM_API_KEY=
# Leave blank to use the provider default.
LLM_MODEL=
# Required only for LLM_PROVIDER=custom
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=45
LLM_MAX_STEPS=6

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Requests per minute per client for LLM-backed endpoints.
ASK_RATE_LIMIT_PER_MINUTE=20
INSIGHTS_CACHE_TTL_SECONDS=600
